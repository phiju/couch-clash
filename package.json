{
  "name": "couch-clash",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @couch-clash/web dev",
    "dev:party": "pnpm --filter @couch-clash/party dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "songs:import": "pnpm --filter @couch-clash/content songs:import",
    "songs:playlists": "pnpm --filter @couch-clash/content songs:playlists"
  }
}
