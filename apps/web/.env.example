# Where the Cloudflare party worker runs (host[:port], no path).
# http/ws is used for localhost and private LAN IPs, https/wss otherwise.
# You can force a protocol with an "http://" or "https://" prefix.

# Local development (pnpm dev):
NEXT_PUBLIC_PARTY_HOST=localhost:1999

# Testing with real phones on your Wi-Fi: use your computer's LAN IP, e.g.
# NEXT_PUBLIC_PARTY_HOST=192.168.1.20:1999

# Production (set this in Vercel → Settings → Environment Variables):
# NEXT_PUBLIC_PARTY_HOST=couch-clash-party.<your-subdomain>.workers.dev
